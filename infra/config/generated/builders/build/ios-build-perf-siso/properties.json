{
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/build/ios-build-perf-siso/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "build",
              "builder": "ios-build-perf-siso",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.build",
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb",
                  "mac_toolchain"
                ],
                "build_config": "Debug",
                "config": "Cinaseek",
                "target_bits": 64,
                "target_platform": "ios"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "siso_latest"
                ],
                "config": "ios"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "build",
          "builder": "ios-build-perf-siso",
          "project": "Cinaseek"
        }
      ]
    }
  },
  "$build/code_coverage": {
    "use_clang_coverage": true
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [
      "no-fallback"
    ],
    "profile_mode": "local",
    "project": "rbe-Cinaseek-untrusted",
    "remote_jobs": -1
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "builder_group": "Cinaseek.build",
  "recipe": "chrome_build/build_perf_siso",
  "xcode_build_version": "17a400"
}