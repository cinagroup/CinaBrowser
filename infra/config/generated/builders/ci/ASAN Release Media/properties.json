{
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/ci/ASAN Release Media/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "ASAN Release Media",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.fuzz",
              "clusterfuzz_archive": {
                "archive_name_prefix": "asan",
                "archive_subdir": "media",
                "gs_acl": "public-read",
                "gs_bucket": "Cinaseek-browser-asan"
              },
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "clobber",
                  "mb"
                ],
                "build_config": "Release",
                "config": "Cinaseek_asan",
                "target_bits": 64,
                "target_platform": "linux"
              },
              "legacy_gclient_config": {
                "config": "Cinaseek"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "ASAN Release Media",
          "project": "Cinaseek"
        }
      ],
      "mirroring_builder_group_and_names": [
        {
          "builder": "linux-asan-media-rel",
          "group": "tryserver.Cinaseek.fuzz"
        }
      ],
      "retry_failed_shards": true,
      "targets_spec_directory": "infra/config/generated/builders/ci/ASAN Release Media/targets"
    }
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [],
    "profile_mode": "cloud",
    "project": "rbe-Cinaseek-trusted",
    "remote_jobs": 250
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "builder_group": "Cinaseek.fuzz",
  "gardener_rotations": [
    "Cinaseek"
  ],
  "recipe": "Cinaseek",
  "sheriff_rotations": [
    "Cinaseek"
  ]
}