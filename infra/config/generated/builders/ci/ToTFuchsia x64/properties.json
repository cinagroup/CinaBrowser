{
  "$build/Cinaseek": {
    "fail_build_on_clang_warnings": true
  },
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/ci/ToTFuchsia x64/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "ToTFuchsia x64",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.clang",
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb"
                ],
                "build_config": "Release",
                "config": "clang_tot_fuchsia",
                "target_bits": 64,
                "target_platform": "fuchsia"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "clang_tot",
                  "fuchsia_x64",
                  "fuchsia_no_hooks"
                ],
                "config": "Cinaseek"
              },
              "run_tests_serially": true
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "ToTFuchsia x64",
          "project": "Cinaseek"
        }
      ],
      "targets_spec_directory": "infra/config/generated/builders/ci/ToTFuchsia x64/targets"
    }
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [],
    "profile_mode": "cloud",
    "project": "rbe-Cinaseek-trusted"
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "builder_group": "Cinaseek.clang",
  "gardener_rotations": [
    "Cinaseek.clang"
  ],
  "perf_dashboard_machine_group": "CinaseekClang",
  "recipe": "Cinaseek",
  "sheriff_rotations": [
    "Cinaseek.clang"
  ]
}