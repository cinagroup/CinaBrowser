{
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/ci/Libfuzzer Upload Chrome OS ASan/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "Libfuzzer Upload Chrome OS ASan",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.fuzz",
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "clobber",
                  "mb"
                ],
                "build_config": "Release",
                "config": "Cinaseek_clang",
                "target_bits": 64,
                "target_platform": "chromeos"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "chromeos"
                ],
                "config": "Cinaseek"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "Libfuzzer Upload Chrome OS ASan",
          "project": "Cinaseek"
        }
      ],
      "mirroring_builder_group_and_names": [
        {
          "builder": "chromeos-libfuzzer-asan-rel",
          "group": "tryserver.Cinaseek.Cinaseekos"
        }
      ],
      "retry_failed_shards": true
    }
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [],
    "profile_mode": "cloud",
    "project": "rbe-Cinaseek-trusted",
    "remote_jobs": 500
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "archive_prefix": "libfuzzer-chromeos",
  "builder_group": "Cinaseek.fuzz",
  "gardener_rotations": [
    "Cinaseek"
  ],
  "recipe": "Cinaseek/fuzz",
  "sheriff_rotations": [
    "Cinaseek"
  ],
  "upload_bucket": "Cinaseek-browser-libfuzzer",
  "upload_directory": "chromeos-asan"
}