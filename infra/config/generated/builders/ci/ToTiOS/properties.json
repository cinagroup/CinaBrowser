{
  "$build/Cinaseek": {
    "fail_build_on_clang_warnings": true
  },
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/ci/ToTiOS/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "ToTiOS",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.clang",
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb",
                  "mac_toolchain"
                ],
                "build_config": "Release",
                "config": "clang_tot_ios",
                "target_bits": 64,
                "target_platform": "ios"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "clang_tot"
                ],
                "config": "ios"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "ToTiOS",
          "project": "Cinaseek"
        }
      ],
      "targets_spec_directory": "infra/config/generated/builders/ci/ToTiOS/targets"
    }
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [],
    "profile_mode": "cloud",
    "project": "rbe-Cinaseek-trusted"
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "builder_group": "Cinaseek.clang",
  "gardener_rotations": [
    "Cinaseek.clang"
  ],
  "perf_dashboard_machine_group": "CinaseekClang",
  "recipe": "Cinaseek",
  "sheriff_rotations": [
    "Cinaseek.clang"
  ],
  "xcode_build_version": "17a400"
}