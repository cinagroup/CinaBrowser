                "apply_configs": [
                  "mb"
                ],
                "build_config": "Release",
                "config": "Cinaseek",
                "target_arch": "intel",
                "target_bits": 64,
                "target_platform": "mac"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "Cinaseek_with_telemetry_dependencies",
