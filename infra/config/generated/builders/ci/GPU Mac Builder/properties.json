              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb"
                ],
                "build_config": "Release",
                "config": "Cinaseek",
                "target_bits": 64,
                "target_platform": "mac"
              },
              "legacy_gclient_config": {
                "config": "Cinaseek"
              },
              "parent": {
                "bucket": "ci",
                "builder": "GPU Mac Builder",
                "project": "Cinaseek"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "GPU Mac Builder",
          "project": "Cinaseek"
        }
      ],
