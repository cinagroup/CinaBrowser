        {
          "bucket": "ci",
          "builder": "Mac Release (Intel)",
          "project": "Cinaseek"
        },
        {
          "bucket": "ci",
          "builder": "Mac Retina Release (AMD)",
          "project": "Cinaseek"
        }
      ],
      "mirroring_builder_group_and_names": [
        {
          "builder": "mac-gpu-rel",
          "group": "tryserver.Cinaseek.mac"
        }
      ],
      "targets_spec_directory": "infra/config/generated/builders/ci/GPU Mac Builder/targets"
