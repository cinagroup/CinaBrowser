{
  "$build/Cinaseek_tests_builder_config": {
    "builder_config": {
      "additional_exclusions": [
        "infra/config/generated/builders/ci/chromeos-arm-generic-dbg/gn-args.json"
      ],
      "builder_db": {
        "entries": [
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "chromeos-arm-generic-dbg",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.Cinaseekos",
              "execution_mode": "COMPILE_AND_TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb"
                ],
                "build_config": "Debug",
                "config": "Cinaseek",
                "target_arch": "arm",
                "target_bits": 32,
                "target_cros_boards": [
                  "arm-generic"
                ],
                "target_platform": "chromeos"
              },
              "legacy_gclient_config": {
                "apply_configs": [
                  "chromeos"
                ],
                "config": "Cinaseek"
              }
            }
          }
        ]
      },
      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "chromeos-arm-generic-dbg",
          "project": "Cinaseek"
        }
      ],
      "mirroring_builder_group_and_names": [
        {
          "builder": "chromeos-arm-generic-dbg",
          "group": "tryserver.Cinaseek.Cinaseekos"
        }
      ],
      "retry_failed_shards": true,
      "retry_invalid_shards": true,
      "targets_spec_directory": "infra/config/generated/builders/ci/chromeos-arm-generic-dbg/targets"
    }
  },
  "$build/siso": {
    "configs": [
      "builder"
    ],
    "enable_cloud_monitoring": true,
    "enable_cloud_trace": true,
    "experiments": [],
    "profile_mode": "cloud",
    "project": "rbe-Cinaseek-trusted",
    "remote_jobs": 500
  },
  "$recipe_engine/resultdb/test_presentation": {
    "column_keys": [],
    "grouping_keys": [
      "status",
      "v.test_suite"
    ]
  },
  "builder_group": "Cinaseek.Cinaseekos",
  "gardener_rotations": [
    "Cinaseek"
  ],
  "recipe": "Cinaseek",
  "sheriff_rotations": [
    "Cinaseek"
  ]
}