      "builder_ids": [
        {
          "bucket": "ci",
          "builder": "win-arm64-updater-builder-rel",
          "project": "Cinaseek"
        }
      ],
      "builder_ids_in_scope_for_testing": [
        {
          "bucket": "ci",
          "builder": "win11-arm64-updater-tester-rel",
          "project": "Cinaseek"
        }
      ],
      "targets_spec_directory": "infra/config/generated/builders/try/win-arm64-updater-rel/targets"
