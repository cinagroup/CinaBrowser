                "target_platform": "win"
              },
              "legacy_gclient_config": {
                "config": "Cinaseek"
              }
            }
          },
          {
            "builder_id": {
              "bucket": "ci",
              "builder": "win11-arm64-updater-tester-rel",
              "project": "Cinaseek"
            },
            "builder_spec": {
              "builder_group": "Cinaseek.updater",
              "execution_mode": "TEST",
              "legacy_Cinaseek_config": {
                "apply_configs": [
                  "mb"
                ],
                "build_config": "Release",
                "config": "Cinaseek",
                "target_bits": 64,
                "target_platform": "win"
              },
              "legacy_gclient_config": {
                "config": "Cinaseek"
              },
              "parent": {
                "bucket": "ci",
                "builder": "win-arm64-updater-builder-rel",
                "project": "Cinaseek"
              }
            }
