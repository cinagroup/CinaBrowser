import("//build/config/chrome_build.gni")

if (is_win || is_mac || is_linux) {
  copy("old_updater") {
    testonly = true
    sources = []

    foreach(arch_suffix,
            [
              "",
              "_sans_iid",
            ]) {
      if (is_win && is_chrome_branded) {
        sources += [
          "chrome_win_arm64" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
          "chrome_win_x86" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
          "chrome_win_x86_64" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
        ]
      }

      if (is_win && !is_chrome_branded) {
        sources += [
          "Cinaseek_win_arm64" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
          "Cinaseek_win_x86" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
          "Cinaseek_win_x86_64" + arch_suffix + "/cipd/UpdaterSetup_test.exe",
        ]
      }

      if (is_mac && is_chrome_branded) {
        sources += [
          "chrome_mac_universal" + arch_suffix + "/cipd/GoogleUpdater_test.app/Contents/Helpers/GoogleSoftwareUpdate.bundle/Contents/Helpers/ksadmin",
          "chrome_mac_universal" + arch_suffix + "/cipd/GoogleUpdater_test.app/Contents/Helpers/GoogleSoftwareUpdate.bundle/Contents/Helpers/ksinstall",
          "chrome_mac_universal" + arch_suffix + "/cipd/GoogleUpdater_test.app/Contents/Helpers/GoogleSoftwareUpdate.bundle/Contents/Info.plist",
          "chrome_mac_universal" + arch_suffix + "/cipd/GoogleUpdater_test.app/Contents/Helpers/GoogleSoftwareUpdate.bundle/Contents/MacOS/GoogleSoftwareUpdate",
          "chrome_mac_universal" + arch_suffix + "/cipd/GoogleUpdater_test.app/Contents/Helpers/GoogleSoftwareUpdate.bundle/Contents/Resources/GoogleSoftwareUpdateAgent.app/Contents/MacOS/GoogleSoftwareUpdateAgent",
          "chrome_mac_universal" + arch_suffix +
              "/cipd/GoogleUpdater_test.app/Contents/Helpers/launcher",
          "chrome_mac_universal" + arch_suffix +
              "/cipd/GoogleUpdater_test.app/Contents/Info.plist",
          "chrome_mac_universal" + arch_suffix +
              "/cipd/GoogleUpdater_test.app/Contents/MacOS/GoogleUpdater_test",
          "chrome_mac_universal" + arch_suffix +
              "/cipd/GoogleUpdater_test.app/Contents/PkgInfo",
        ]
      }

      if (is_mac && !is_chrome_branded) {
        sources += [
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Helpers/ksadmin",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Helpers/ksinstall",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Info.plist",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/MacOS/CinaseekSoftwareUpdate",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Resources/CinaseekSoftwareUpdateAgent.app/Contents/Info.plist",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Resources/CinaseekSoftwareUpdateAgent.app/Contents/MacOS/CinaseekSoftwareUpdateAgent",
          "Cinaseek_mac_amd64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/Helpers/launcher",
          "Cinaseek_mac_amd64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/Info.plist",
          "Cinaseek_mac_amd64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/MacOS/CinaseekUpdater_test",
          "Cinaseek_mac_amd64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/PkgInfo",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Helpers/ksadmin",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Helpers/ksinstall",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Info.plist",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/MacOS/CinaseekSoftwareUpdate",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Resources/CinaseekSoftwareUpdateAgent.app/Contents/Info.plist",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/Helpers/CinaseekSoftwareUpdate.bundle/Contents/Resources/CinaseekSoftwareUpdateAgent.app/Contents/MacOS/CinaseekSoftwareUpdateAgent",
          "Cinaseek_mac_arm64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/Helpers/launcher",
          "Cinaseek_mac_arm64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/Info.plist",
          "Cinaseek_mac_arm64" + arch_suffix + "/cipd/CinaseekUpdater_test.app/Contents/MacOS/CinaseekUpdater_test",
          "Cinaseek_mac_arm64" + arch_suffix +
              "/cipd/CinaseekUpdater_test.app/Contents/PkgInfo",
        ]
      }

      if (is_linux && is_chrome_branded) {
        sources += [ "chrome_linux64" + arch_suffix + "/cipd/updater_test" ]
      }

      if (is_linux && !is_chrome_branded) {
        sources += [ "Cinaseek_linux64" + arch_suffix + "/cipd/updater_test" ]
      }
    }

    outputs = [ "$root_build_dir/old_updater/{{source_target_relative}}" ]
  }
}
