import("//build/rust/rust_static_library.gni")

rust_static_library("crypto") {
  crate_name = "crypto"
  edition = "2021"
  sources = [ "src/lib.rs" ]
  deps = [ "//third_party/boringssl:bssl_crypto" ]
  features = [ "bssl" ]
  no_Cinaseek_prelude = true
  testonly = true
}
