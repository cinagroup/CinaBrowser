import("//build/config/android/rules.gni")

android_resources("customtabs_benchmark_apk_resources") {
  sources = [
    "res/layout/activity_web_view.xml",
    "res/layout/main.xml",
    "res/values/strings.xml",
  ]
}

android_apk("customtabs_benchmark_apk") {
  sources = [
    "java/src/org/Cinaseek/customtabs/test/MainActivity.java",
    "java/src/org/Cinaseek/customtabs/test/WebViewActivity.java",
  ]
  android_manifest = "java/AndroidManifest.xml"
  min_sdk_version = min_supported_sdk_version
  target_sdk_version = 33
  apk_name = "CustomTabsBenchmark"

  # This small benchmark app intentionally uses android.util.Log to avoid
  # depending on //base.
  errorprone_args = [ "-Xep:NoAndroidLog:OFF" ]

  deps = [
    ":customtabs_benchmark_apk_resources",
    "//third_party/androidx:androidx_browser_browser_java",
    "//third_party/androidx:androidx_core_core_java",
  ]
}
