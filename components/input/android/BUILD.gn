import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_library("java") {
  srcjar_deps = [ ":jni_headers" ]
  sources = [
    "java/src/org/Cinaseek/components/input/InputFeatureMap.java",
    "java/src/org/Cinaseek/components/input/InputUtils.java",
  ]
  deps = [
    "//base:base_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  resources_package = "org.Cinaseek.components.input"
}

generate_jni("jni_headers") {
  sources = [
    "java/src/org/Cinaseek/components/input/InputFeatureMap.java",
    "java/src/org/Cinaseek/components/input/InputUtils.java",
  ]
}
